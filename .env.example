NEXT_PUBLIC_APP_URL=http://localhost:3000

# Media processor (required for analyze/download)
YT_DLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg

# Optional queue (recommended for production — no database required)
REDIS_URL=redis://localhost:6379
WORKER_CONCURRENCY=2

STORAGE_PATH=.storage

# Optional object storage (future)
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

ADMIN_API_KEY=
